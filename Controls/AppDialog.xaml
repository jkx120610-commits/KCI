<Window x:Class="KCI.Controls.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KCI" Width="980" Height="680"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        ShowInTaskbar="False">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="23" FontWeight="SemiBold" />
        <TextBlock x:Name="SubtitleText" Style="{StaticResource DataLabel}" Margin="0,5,0,0" />
      </StackPanel>
      <Grid Grid.Column="1" Width="220" Height="36" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Padding="10,7"
                 Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                 ToolTip="搜索软件名称或发布者"
                 VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
        <TextBlock x:Name="SearchHint" Text="搜索名称或发布者" Margin="11,0,0,0"
                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                   IsHitTestVisible="False" />
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
            CornerRadius="7" Padding="12,9" Margin="0,16,0,12">
      <TextBlock x:Name="WarningText" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1" CornerRadius="8" Padding="8">
      <DataGrid x:Name="ItemsGrid" SelectionMode="Extended">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn x:Name="SelectionColumn" Header="选择" Width="62"
                                  Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
          <DataGridTemplateColumn Header="图标" Width="52">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"
                              ElementStyle="{StaticResource GridTextCell}" />
          <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="*"
                              ElementStyle="{StaticResource GridTextCell}" />
          <DataGridTextColumn Header="占用" Binding="{Binding SizeText}" Width="95" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Grid.Row="3" Margin="0,16,0,0">
      <TextBlock x:Name="CountText" Style="{StaticResource DataLabel}" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SelectSafeButton" Content="选择可处理项" Style="{StaticResource SecondaryButton}"
                Margin="0,0,10,0" Click="SelectSafeButton_Click" />
        <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}"
                Margin="0,0,10,0" Click="CancelButton_Click" />
        <Button x:Name="ConfirmButton" Content="继续" Style="{StaticResource PrimaryButton}"
                Click="ConfirmButton_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
