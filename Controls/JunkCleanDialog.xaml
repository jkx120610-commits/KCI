<Window x:Class="KCI.Controls.JunkCleanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KCI 垃圾数据清理" Width="1040" Height="700"
        MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        ShowInTaskbar="False">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="垃圾数据清理" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="下载安装包、软件缓存、临时文件和系统垃圾" Margin="0,5,0,0"
                 Style="{StaticResource DataLabel}" />
    </StackPanel>

    <Border Grid.Row="1" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
            CornerRadius="7" Padding="12,9" Margin="0,16,0,12">
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}"
                 Text="下载目录中的安装包默认不勾选，请确认不再需要后再清理。缓存和垃圾项目执行后不可恢复，但不会删除文档、照片、视频或普通用户文件。" />
    </Border>

    <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1" CornerRadius="8" Padding="8">
      <DataGrid x:Name="ItemsGrid" SelectionMode="Extended">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="选择" Width="62"
                                  Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
          <DataGridTemplateColumn Header="" Width="44">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                           FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="120" />
          <DataGridTextColumn Header="项目" Binding="{Binding Name}" Width="1.2*"
                              ElementStyle="{StaticResource GridTextCell}" />
          <DataGridTextColumn Header="位置" Binding="{Binding PathText}" Width="2*"
                              ElementStyle="{StaticResource GridTextCell}" />
          <DataGridTextColumn Header="占用" Binding="{Binding SizeText}" Width="100" />
          <DataGridTextColumn Header="建议" Binding="{Binding RiskText}" Width="95" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Grid.Row="3" Margin="0,15,0,0">
      <TextBlock x:Name="CountText" Style="{StaticResource DataLabel}"
                 VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="选择推荐项" Style="{StaticResource SecondaryButton}"
                Margin="0,0,8,0" Click="SelectRecommended_Click" />
        <Button Content="取消" Style="{StaticResource SecondaryButton}"
                Margin="0,0,8,0" Click="Cancel_Click" />
        <Button Content="清理选中项" Style="{StaticResource DangerButton}"
                Click="Confirm_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
