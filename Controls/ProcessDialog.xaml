<Window x:Class="KCI.Controls.ProcessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KCI RAM 超级释放器" Width="860" Height="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}"
        ShowInTaskbar="False">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="RAM 超级释放器" FontSize="23" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Margin="0,8,0,14" TextWrapping="Wrap"
               Foreground="{DynamicResource WarningTextBrush}" Background="{DynamicResource WarningSurfaceBrush}"
               Padding="12,9" Text="系统进程、桌面外壳和 KCI 已自动排除。结束应用可能丢失未保存内容，请先确认选择。" />
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
      <DataGrid x:Name="ItemsGrid">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="选择" Width="62"
                                  Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
          <DataGridTextColumn Header="应用" Binding="{Binding Name}" Width="1.4*" />
          <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="2*" />
          <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
          <DataGridTextColumn Header="内存" Binding="{Binding MemoryText}" Width="95" />
          <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="85" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Grid Grid.Row="3" Margin="0,15,0,0">
      <TextBlock x:Name="CountText" Foreground="{DynamicResource TextSecondaryBrush}"
                 VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                Click="Cancel_Click" />
        <Button Content="结束选中应用" Style="{StaticResource DangerButton}"
                Click="Confirm_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
