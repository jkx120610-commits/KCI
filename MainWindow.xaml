<Window x:Class="KCI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KCI · Kerwin Computer Insight"
        Width="1380" Height="860" MinWidth="1100" MinHeight="690"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WindowBrush}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="86" />
          <RowDefinition Height="*" />
          <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Grid Margin="20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BadgeBackgroundBrush}"
                  VerticalAlignment="Center">
            <TextBlock Text="K" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="KCI" FontSize="21" FontWeight="Bold" />
            <TextBlock Text="Computer Insight" FontSize="10.5"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
          <TextBlock Text="硬件信息" Style="{StaticResource DataLabel}" Margin="24,6,0,8" />
          <Button x:Name="CpuNavButton" Tag="CPU" Style="{StaticResource NavButton}"
                  Click="NavButton_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE950;" Style="{StaticResource IconText}" />
              <TextBlock Grid.Column="1" Text="CPU" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button x:Name="GpuNavButton" Tag="GPU" Style="{StaticResource NavButton}"
                  Click="NavButton_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE7F4;" Style="{StaticResource IconText}" />
              <TextBlock Grid.Column="1" Text="GPU" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button x:Name="WlanNavButton" Tag="WLAN" Style="{StaticResource NavButton}"
                  Click="NavButton_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE968;" Style="{StaticResource IconText}" />
              <TextBlock Grid.Column="1" Text="WLAN" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button x:Name="BatteryNavButton" Tag="Battery" Style="{StaticResource NavButton}"
                  Click="NavButton_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE83F;" Style="{StaticResource IconText}" />
              <TextBlock Grid.Column="1" Text="电池" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button x:Name="DisplayNavButton" Tag="Display" Style="{StaticResource NavButton}"
                  Click="NavButton_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE7F8;" Style="{StaticResource IconText}" />
              <TextBlock Grid.Column="1" Text="屏幕" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button x:Name="MemoryNavButton" Tag="Memory" Style="{StaticResource NavButton}"
                  Click="NavButton_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE964;" Style="{StaticResource IconText}" />
              <TextBlock Grid.Column="1" Text="内存与存储" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <TextBlock Text="KCI" Style="{StaticResource DataLabel}" Margin="24,18,0,8" />
          <Button x:Name="HelpNavButton" Tag="Help" Style="{StaticResource NavButton}"
                  Click="NavButton_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE897;" Style="{StaticResource IconText}" />
              <TextBlock Grid.Column="1" Text="KCI Help" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button x:Name="InfoNavButton" Tag="Info" Style="{StaticResource NavButton}"
                  Click="NavButton_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" />
              <TextBlock Grid.Column="1" Text="KCI 信息" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>

        <Grid Grid.Row="2" Margin="20,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Version 1.0.0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="Author  Kerwin" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,3,0,0" />
            <TextBlock Text="GitHub  @jkx120610-commits" FontSize="10"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="82" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource WindowHeaderBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="24,0,16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" ClipToBounds="True">
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="PageTitleText" Text="CPU" FontSize="20" FontWeight="SemiBold" />
              <TextBlock x:Name="HostText" Text="正在读取主机信息" MaxWidth="620"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                         Margin="0,4,0,0" />
              <Border Width="34" Height="3" Background="{DynamicResource AccentBrush}"
                      CornerRadius="2" HorizontalAlignment="Left" Margin="0,7,0,0" />
            </StackPanel>
          </Grid>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                      Margin="0,0,22,0">
            <StackPanel Margin="0,0,22,0">
              <TextBlock Text="CPU" Style="{StaticResource DataLabel}" />
              <TextBlock x:Name="HeaderCpuText" Text="--" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Margin="0,0,22,0">
              <TextBlock Text="GPU" Style="{StaticResource DataLabel}" />
              <TextBlock x:Name="HeaderGpuText" Text="--" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Margin="0,0,22,0">
              <TextBlock Text="RAM" Style="{StaticResource DataLabel}" />
              <TextBlock x:Name="HeaderMemoryText" Text="--" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="传感器" Style="{StaticResource DataLabel}" />
              <TextBlock x:Name="HeaderSensorText" Text="连接中" FontSize="12"
                         Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource WindowControlButton}"
                    ToolTip="最小化" Click="MinimizeButton_Click">
              <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="12" />
            </Button>
            <Button Style="{StaticResource WindowControlButton}"
                    ToolTip="最大化" Click="MaximizeButton_Click">
              <TextBlock Text="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="12" />
            </Button>
            <Button Style="{StaticResource WindowCloseButton}"
                    ToolTip="关闭" Click="CloseButton_Click">
              <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="12"
                         />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <ContentControl x:Name="PageHost" />
        <Border x:Name="LoadingOverlay" Background="{DynamicResource LoadingOverlayBrush}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="260" Height="5" />
            <TextBlock Text="正在初始化硬件传感器和系统参数..." Margin="0,16,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
