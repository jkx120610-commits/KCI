<UserControl x:Class="KCI.Views.CpuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KCI.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <Grid Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Text="CPU" FontSize="28" FontWeight="SemiBold" />
          <TextBlock x:Name="CpuNameText" Style="{StaticResource DataLabel}" Margin="0,5,0,0" />
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="{DynamicResource BadgeBackgroundBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="12,6">
          <TextBlock x:Name="CpuStatusText" Foreground="{DynamicResource AccentBrush}" />
        </Border>
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="230" />
          <ColumnDefinition Width="230" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,14,14">
          <controls:UsageRing x:Name="LoadRing" Title="占用率" Unit="%" Accent="{DynamicResource AccentBrush}" />
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,14">
          <controls:UsageRing x:Name="TempRing" Title="封装温度" Unit="°" Accent="{DynamicResource WarmBrush}" />
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="实时负载" Style="{StaticResource SectionTitle}" />
            <controls:HistoryChart x:Name="LoadChart" Grid.Row="1" MinHeight="150"
                                   Accent="{DynamicResource AccentBrush}" />
          </Grid>
        </Border>
      </Grid>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="处理器参数" Style="{StaticResource SectionTitle}" />
          <ItemsControl x:Name="SpecsItems">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,16,16">
                  <TextBlock Text="{Binding Label}" Style="{StaticResource DataLabel}" />
                  <TextBlock Text="{Binding Value}" Style="{StaticResource DataValue}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="CPU 占用应用" Style="{StaticResource SectionTitle}" />
            <Button x:Name="CloseProcessButton" Content="结束选中应用"
                    Style="{StaticResource DangerButton}" HorizontalAlignment="Right"
                    Click="CloseProcessButton_Click" />
          </Grid>
          <DataGrid x:Name="ProcessGrid" Grid.Row="1">
            <DataGrid.Columns>
              <DataGridTextColumn Header="应用" Binding="{Binding Name}" Width="1.2*" />
              <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="2*" />
              <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
              <DataGridTextColumn Header="CPU" Binding="{Binding CpuPercent, StringFormat={}{0:0.0}%}" Width="90" />
              <DataGridTextColumn Header="内存" Binding="{Binding MemoryMb, StringFormat={}{0:0.0} MB}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
