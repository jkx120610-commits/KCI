<UserControl x:Class="KCI.Views.DisplayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <Grid Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Text="屏幕" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="显示器参数、像素检测与灰阶测试" Style="{StaticResource DataLabel}" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="纯色 / 坏点测试" Style="{StaticResource PrimaryButton}"
                  Margin="0,0,10,0" Click="ColorTestButton_Click" />
          <Button Content="刷新显示器参数" Style="{StaticResource SecondaryButton}"
                  Click="RefreshButton_Click" />
        </StackPanel>
      </Grid>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="显示器列表" Style="{StaticResource SectionTitle}" />
          <ItemsControl x:Name="DisplayItems">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource PanelInsetBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                        CornerRadius="8" Padding="16" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.6*" />
                      <ColumnDefinition Width="0.9*" />
                      <ColumnDefinition Width="0.95*" />
                      <ColumnDefinition Width="0.75*" />
                      <ColumnDefinition Width="0.65*" />
                      <ColumnDefinition Width="1.25*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                                Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Text="主显示器" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding DeviceName}" Style="{StaticResource DataLabel}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,12,0">
                      <TextBlock Text="接口" Style="{StaticResource DataLabel}" />
                      <TextBlock Text="{Binding InterfaceType}" Style="{StaticResource DataValue}"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding InterfaceType}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                      <TextBlock Text="分辨率" Style="{StaticResource DataLabel}" />
                      <TextBlock Text="{Binding Resolution}" Style="{StaticResource DataValue}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                      <TextBlock Text="刷新率" Style="{StaticResource DataLabel}" />
                      <TextBlock Text="{Binding RefreshRate}" Style="{StaticResource DataValue}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,10,0">
                      <TextBlock Text="色深" Style="{StaticResource DataLabel}" />
                      <TextBlock Text="{Binding ColorDepth}" Style="{StaticResource DataValue}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" Margin="4,0,0,0">
                      <TextBlock Text="DPI / 工作区" Style="{StaticResource DataLabel}" />
                      <TextBlock Text="{Binding Dpi}" Style="{StaticResource DataValue}" />
                      <TextBlock Text="{Binding WorkArea}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,7,0">
          <StackPanel>
            <TextBlock Text="显示适配器" Style="{StaticResource SectionTitle}" />
            <ItemsControl x:Name="AdapterItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Resolution}" Style="{StaticResource DataLabel}" />
                    <TextBlock Text="{Binding DriverVersion}" Style="{StaticResource DataLabel}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
          <StackPanel>
            <TextBlock Text="测试说明" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       LineHeight="23">
              纯色测试会依次显示红、绿、蓝、白、黑及灰阶画面。单击或按空格切换，按 Esc 退出。
              检查画面是否有亮点、暗点、色偏与明显漏光。
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
