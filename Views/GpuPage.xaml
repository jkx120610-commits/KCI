<UserControl x:Class="KCI.Views.GpuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KCI.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <Grid Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Text="GPU" FontSize="28" FontWeight="SemiBold" />
          <TextBlock x:Name="GpuNameText" Style="{StaticResource DataLabel}" Margin="0,5,0,0" />
          <TextBlock x:Name="GpuMemoryText" Style="{StaticResource DataLabel}" Margin="0,3,0,0" />
        </StackPanel>
        <TextBlock x:Name="SensorStatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="230" />
          <ColumnDefinition Width="230" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,14,14">
          <controls:UsageRing x:Name="LoadRing" Title="GPU 占用" Unit="%" Accent="{DynamicResource AccentBrush}" />
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,14">
          <controls:UsageRing x:Name="TempRing" Title="核心温度" Unit="°" Accent="{DynamicResource BlueAccentBrush}" />
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="实时负载" Style="{StaticResource SectionTitle}" />
            <controls:HistoryChart x:Name="LoadChart" Grid.Row="1" MinHeight="150"
                                   Accent="{DynamicResource BlueAccentBrush}" />
          </Grid>
        </Border>
      </Grid>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="显卡参数" Style="{StaticResource SectionTitle}" />
          <ItemsControl x:Name="GpuItems">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource PanelInsetBrush}" CornerRadius="7" Padding="14" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.7*" />
                      <ColumnDefinition Width="1.2*" />
                      <ColumnDefinition Width="1.1*" />
                      <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                      <TextBlock Text="{Binding Vendor}" Style="{StaticResource DataLabel}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="18,0,12,0">
                      <TextBlock Text="驱动" Style="{StaticResource DataLabel}" />
                      <TextBlock Text="{Binding DriverVersion}" Style="{StaticResource DataValue}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                      <TextBlock Text="显存" Style="{StaticResource DataLabel}" />
                      <TextBlock Text="{Binding TotalRam}" Style="{StaticResource DataValue}" Margin="0,4,0,2" />
                      <TextBlock Text="{Binding AdapterRam}" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Text="{Binding SharedRam}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="12,0,0,0">
                      <TextBlock Text="输出" Style="{StaticResource DataLabel}" />
                      <TextBlock Text="{Binding Resolution}" Style="{StaticResource DataValue}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="280" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="高占用应用" Style="{StaticResource SectionTitle}" />
            <Button Content="结束选中应用" Style="{StaticResource DangerButton}"
                    HorizontalAlignment="Right" Click="CloseProcessButton_Click" />
          </Grid>
          <DataGrid x:Name="ProcessGrid" Grid.Row="1">
            <DataGrid.Columns>
              <DataGridTextColumn Header="应用" Binding="{Binding Name}" Width="1.2*" />
              <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="2*" />
              <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
              <DataGridTextColumn Header="CPU" Binding="{Binding CpuPercent, StringFormat={}{0:0.0}%}" Width="90" />
              <DataGridTextColumn Header="GPU" Binding="{Binding GpuPercent, StringFormat={}{0:0.0}%}" Width="90" />
              <DataGridTextColumn Header="内存" Binding="{Binding MemoryMb, StringFormat={}{0:0.0} MB}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
