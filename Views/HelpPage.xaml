<UserControl x:Class="KCI.Views.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <StackPanel Margin="0,0,0,18">
        <TextBlock Text="KCI Help" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="系统维护工具 · 每次执行均生成日志报告" Style="{StaticResource DataLabel}"
                   Margin="0,5,0,0" />
      </StackPanel>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="48" Height="48" CornerRadius="8" Background="{DynamicResource DangerSurfaceBrush}">
            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="24"
                       Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,18,0">
            <TextBlock Text="360 全家桶卸载器" FontSize="17" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0">
              检测已安装的 360 软件，可多选卸载；随后停止 360 进程与服务，并清理受控目录和注册表残留。
              执行前会显示选中项并要求二次确认。
            </TextBlock>
          </StackPanel>
          <Button x:Name="Remove360Button" Grid.Column="2" Content="扫描并选择"
                  Style="{StaticResource DangerButton}" VerticalAlignment="Center"
                  Click="Remove360Button_Click" />
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="48" Height="48" CornerRadius="8" Background="{DynamicResource CardHoverBrush}">
            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="24"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,18,0">
            <TextBlock Text="垃圾数据清理" FontSize="17" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0">
              扫描下载目录中的安装包、软件和浏览器缓存、开发工具缓存、临时文件、崩溃转储、
              Windows 错误报告、缩略图缓存和回收站。安装包默认不勾选，清理前需要两次确认。
            </TextBlock>
          </StackPanel>
          <Button x:Name="CleanJunkButton" Grid.Column="2" Content="扫描垃圾数据"
                  Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                  Click="CleanJunkButton_Click" />
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="48" Height="48" CornerRadius="8" Background="{DynamicResource BadgeBackgroundBrush}">
            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="24"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,18,0">
            <TextBlock Text="RAM 超级释放器" FontSize="17" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0">
              列出所有可结束的用户应用，系统进程、桌面外壳和 KCI 自身自动排除。可逐项选择，
              结束后输出预计释放量与实际处理结果。
            </TextBlock>
          </StackPanel>
          <Button x:Name="ReleaseRamButton" Grid.Column="2" Content="预览并释放"
                  Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                  Click="ReleaseRamButton_Click" />
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="48" Height="48" CornerRadius="8" Background="{DynamicResource WarningSurfaceBrush}">
            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="24"
                       Foreground="{DynamicResource WarmBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,18,0">
            <TextBlock Text="SSD / HDD 超级清除" FontSize="17" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0">
              读取已安装软件、图标和占用空间。选择应用后先调用官方卸载程序，再扫描其安装目录、
              AppData、ProgramData 和注册表中的明确残留。系统组件与 KCI 不可选择。
            </TextBlock>
          </StackPanel>
          <Button x:Name="DeepCleanButton" Grid.Column="2" Content="读取软件清单"
                  Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                  Click="DeepCleanButton_Click" />
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="48" Height="48" CornerRadius="8" Background="{DynamicResource BlueSurfaceBrush}">
            <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="24"
                       Foreground="{DynamicResource BlueAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,18,0">
            <TextBlock Text="Windows 停止更新" FontSize="17" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0">
              按所选时间暂停 Windows 更新服务、更新计划任务与自动更新策略。KCI 会创建到期恢复任务，
              到期后自动还原，也可随时手动恢复。安全更新会同时暂停，请自行评估风险。
            </TextBlock>
            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource DataLabel}" Margin="0,8,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="180">
            <UniformGrid Columns="3" Margin="0,0,0,8">
              <RadioButton x:Name="UpdateOneMonth" Content="1 个月" GroupName="UpdateDuration"
                           IsChecked="True" Style="{StaticResource SegmentRadio}" Margin="0,0,5,0" />
              <RadioButton x:Name="UpdateSixMonths" Content="半年" GroupName="UpdateDuration"
                           Style="{StaticResource SegmentRadio}" Margin="2,0,2,0" />
              <RadioButton x:Name="UpdateOneYear" Content="1 年" GroupName="UpdateDuration"
                           Style="{StaticResource SegmentRadio}" Margin="5,0,0,0" />
            </UniformGrid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="RestoreUpdatesButton" Content="恢复更新"
                      Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                      Click="RestoreUpdatesButton_Click" />
              <Button x:Name="PauseUpdatesButton" Content="暂停更新"
                      Style="{StaticResource DangerButton}" Click="PauseUpdatesButton_Click" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="执行状态" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="StatusText" Text="等待操作" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="LastReportText" Style="{StaticResource DataLabel}" Margin="0,8,0,0" />
          </StackPanel>
          <Button x:Name="OpenReportButton" Grid.Column="1" Content="打开最近报告"
                  Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                  IsEnabled="False" Click="OpenReportButton_Click" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
