<UserControl x:Class="KCI.Views.InfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <StackPanel Margin="0,0,0,18">
        <TextBlock Text="KCI 信息" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Kerwin Computer Insight" Style="{StaticResource DataLabel}"
                   Margin="0,5,0,0" />
      </StackPanel>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.45*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,14,14">
          <StackPanel>
            <Border Width="78" Height="78" CornerRadius="16" Background="{DynamicResource BadgeBackgroundBrush}"
                    HorizontalAlignment="Left">
              <TextBlock Text="K" FontFamily="Segoe UI" FontSize="42" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="KCI" FontSize="36" FontWeight="Bold" Margin="0,18,0,0" />
            <TextBlock Text="Kerwin Computer Insight" FontSize="16"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="14" LineHeight="24" Margin="0,18,0,0">
              KCI 是一款面向 Windows 的硬件信息与系统维护工具。它将 CPU、GPU、电池、屏幕、
              RAM、SSD/HDD 的参数与实时传感器数据集中在一个低干扰界面中，并提供带审计报告的
              内存释放、360 组件卸载和软件数据清理工具。
            </TextBlock>
            <Grid Margin="0,24,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="作者" Style="{StaticResource DataLabel}" />
                <TextBlock Text="Kerwin" Style="{StaticResource DataValue}" />
                <TextBlock Text="GitHub" Style="{StaticResource DataLabel}" Margin="0,-4,0,0" />
                <TextBlock x:Name="GithubAuthorText" Text="未配置"
                           Style="{StaticResource DataValue}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="版本" Style="{StaticResource DataLabel}" />
                <TextBlock Text="1.0.0" Style="{StaticResource DataValue}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="引擎" Style="{StaticResource DataLabel}" />
                <TextBlock Text=".NET 8 / WPF" Style="{StaticResource DataValue}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1">
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="意见反馈" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="建议邮箱" Style="{StaticResource DataLabel}" />
              <TextBlock Text="2100680885@qq.com" FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
              <TextBlock Text="意见反馈" Style="{StaticResource DataLabel}" Margin="0,14,0,0" />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                         LineHeight="22">
                遇到问题或有功能建议，可以发送到这个邮箱，也可以到 GitHub 提交反馈。
              </TextBlock>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="发送邮件" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0" Click="EmailButton_Click" />
                <Button Content="打开 GitHub" Style="{StaticResource SecondaryButton}"
                        Click="GithubButton_Click" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="系统概览" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="SystemText" TextWrapping="Wrap" LineHeight="23"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="硬件摘要" Style="{StaticResource SectionTitle}" />
          <ItemsControl x:Name="SummaryItems">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,18,16">
                  <TextBlock Text="{Binding Label}" Style="{StaticResource DataLabel}" />
                  <TextBlock Text="{Binding Value}" Style="{StaticResource DataValue}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="数据与许可" Style="{StaticResource SectionTitle}" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="23">
            传感器读取使用 LibreHardwareMonitorLib。WMI、注册表、性能计数器和 Windows 原生 API
            用于补充静态硬件参数。温度、风扇、电压等数据取决于主板、驱动和传感器暴露情况；
            显示“--”表示当前设备未提供该传感器。KCI 需要管理员权限才能读取完整传感器信息并执行维护操作。
          </TextBlock>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
