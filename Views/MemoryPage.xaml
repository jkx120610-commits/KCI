<UserControl x:Class="KCI.Views.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KCI.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <StackPanel Margin="0,0,0,18">
        <TextBlock Text="内存与存储" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="RAM 实时状态、内存模组、SSD/HDD 健康与空间" Style="{StaticResource DataLabel}"
                   Margin="0,5,0,0" />
      </StackPanel>

      <TabControl x:Name="StorageTabs" SelectionChanged="StorageTabs_SelectionChanged">
        <TabItem Header="RAM">
          <StackPanel Margin="0,16,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                <controls:UsageRing x:Name="MemoryRing" Title="RAM 占用" Unit="%"
                                    Accent="{DynamicResource AccentBrush}" />
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,14">
                <controls:UsageRing x:Name="MemoryTempRing" Title="内存温度" Unit="°"
                                    Accent="{DynamicResource WarmBrush}" />
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="RAM 占用历史" Style="{StaticResource SectionTitle}" />
                  <controls:HistoryChart x:Name="MemoryChart" Grid.Row="1" MinHeight="150"
                                         Accent="{DynamicResource AccentBrush}" />
                </Grid>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="内存模组" Style="{StaticResource SectionTitle}" />
                <DataGrid x:Name="MemoryGrid" Height="180">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="插槽" Binding="{Binding Locator}" Width="*" />
                    <DataGridTextColumn Header="容量" Binding="{Binding Capacity}" Width="110" />
                    <DataGridTextColumn Header="速度" Binding="{Binding Speed}" Width="120" />
                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90" />
                    <DataGridTextColumn Header="制造商" Binding="{Binding Manufacturer}" Width="150" />
                    <DataGridTextColumn Header="型号" Binding="{Binding PartNumber}" Width="1.5*" />
                    <DataGridTextColumn Header="序列号" Binding="{Binding SerialNumber}" Width="160" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="280" />
                </Grid.RowDefinitions>
                <Grid>
                  <TextBlock Text="内存占用应用" Style="{StaticResource SectionTitle}" />
                  <Button Content="结束选中应用" Style="{StaticResource DangerButton}"
                          HorizontalAlignment="Right" Click="CloseProcessButton_Click" />
                </Grid>
                <DataGrid x:Name="ProcessGrid" Grid.Row="1">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="应用" Binding="{Binding Name}" Width="1.2*" />
                    <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="2*" />
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                    <DataGridTextColumn Header="内存" Binding="{Binding MemoryMb, StringFormat={}{0:0.0} MB}" Width="120" />
                    <DataGridTextColumn Header="CPU" Binding="{Binding CpuPercent, StringFormat={}{0:0.0}%}" Width="90" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>
          </StackPanel>
        </TabItem>

        <TabItem Header="SSD / HDD">
          <StackPanel Margin="0,16,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                <StackPanel HorizontalAlignment="Center">
                  <controls:UsageRing x:Name="StorageRing" Title="磁盘已用" Unit="%"
                                      Accent="{DynamicResource BlueAccentBrush}" Width="190" Height="190" />
                  <TextBlock x:Name="VolumeSummaryText" Style="{StaticResource DataValue}"
                             HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" />
                  <TextBlock x:Name="VolumeSummaryPercentText" Style="{StaticResource DataLabel}"
                             HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="存储空间" Style="{StaticResource SectionTitle}" />
                  <DataGrid x:Name="VolumeGrid" Height="170">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="盘符" Binding="{Binding Drive}" Width="80" />
                      <DataGridTextColumn Header="卷标" Binding="{Binding Label}" Width="*" />
                      <DataGridTextColumn Header="文件系统" Binding="{Binding FileSystem}" Width="100" />
                      <DataGridTextColumn Header="总容量" Binding="{Binding Total}" Width="110" />
                      <DataGridTextColumn Header="已使用" Binding="{Binding Used}" Width="110" />
                      <DataGridTextColumn Header="可用" Binding="{Binding Free}" Width="110" />
                      <DataGridTextColumn Header="占用" Binding="{Binding UsagePercent, StringFormat={}{0:0.0}%}" Width="90" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="应用自身安装占用" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock x:Name="AppUsageStatusText" Style="{StaticResource DataLabel}"
                               Text="等待扫描所有固定磁盘上的桌面应用" />
                  </StackPanel>
                  <Button x:Name="RefreshAppUsageButton" Content="刷新应用占用"
                          Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Click="RefreshAppUsageButton_Click" />
                </Grid>
                <DataGrid x:Name="AppUsageGrid" Height="340">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="图标" Width="52">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="应用" Binding="{Binding Name}" Width="1.35*"
                                        ElementStyle="{StaticResource GridTextCell}" />
                    <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="1.1*"
                                        ElementStyle="{StaticResource GridTextCell}" />
                    <DataGridTextColumn Header="安装位置" Binding="{Binding Location}" Width="1.8*"
                                        ElementStyle="{StaticResource GridTextCell}" />
                    <DataGridTextColumn Header="占用空间" Binding="{Binding SizeText}" Width="110" />
                    <DataGridTextColumn Header="应用占比" Binding="{Binding ShareText}" Width="100" />
                    <DataGridTextColumn Header="口径" Binding="{Binding SizeSource}" Width="90" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="物理磁盘" Style="{StaticResource SectionTitle}" />
                <ItemsControl x:Name="StorageItems">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource PanelInsetBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                              CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SerialNumber}" Style="{StaticResource DataLabel}" Margin="0,4,0,0" />
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="类型 / 总线" Style="{StaticResource DataLabel}" />
                            <TextBlock Text="{Binding MediaType}" Style="{StaticResource DataValue}" />
                            <TextBlock Text="{Binding BusType}" Foreground="{DynamicResource TextSecondaryBrush}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="容量" Style="{StaticResource DataLabel}" />
                            <TextBlock Text="{Binding Size}" Style="{StaticResource DataValue}" />
                          </StackPanel>
                          <StackPanel Grid.Column="3">
                            <TextBlock Text="健康" Style="{StaticResource DataLabel}" />
                            <TextBlock Text="{Binding Health}" Style="{StaticResource DataValue}" />
                          </StackPanel>
                          <StackPanel Grid.Column="4">
                            <TextBlock Text="温度 / 占用" Style="{StaticResource DataLabel}" />
                            <TextBlock Text="{Binding Temperature, StringFormat={}{0:0.#} °C}" Style="{StaticResource DataValue}" />
                            <TextBlock Text="{Binding UsagePercent, StringFormat={}{0:0.0}%}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
