<UserControl x:Class="KCI.Views.WlanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KCI.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <Grid Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Text="WLAN" FontSize="28" FontWeight="SemiBold" />
          <TextBlock x:Name="WlanNameText" Style="{StaticResource DataLabel}" Margin="0,5,0,0"
                     Text="正在读取无线连接..." />
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="{DynamicResource BadgeBackgroundBrush}"
                BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="12,6">
          <TextBlock x:Name="StatusBadgeText" Foreground="{DynamicResource AccentBrush}"
                     Text="读取中" />
        </Border>
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,14,14">
          <StackPanel HorizontalAlignment="Center">
            <controls:UsageRing x:Name="SignalRing" Title="信号强度" Unit="%"
                                Accent="{DynamicResource AccentBrush}" Width="170" Height="170" />
            <TextBlock x:Name="SecurityText" Style="{StaticResource DataValue}"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,14">
          <StackPanel>
            <TextBlock Text="当前连接" Style="{StaticResource SectionTitle}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="网络名称" Style="{StaticResource DataLabel}" />
                <TextBlock x:Name="SsidText" Style="{StaticResource DataValue}" />
                <TextBlock Text="IP 地址" Style="{StaticResource DataLabel}" />
                <TextBlock x:Name="IpText" Style="{StaticResource DataValue}" />
                <TextBlock Text="默认网关" Style="{StaticResource DataLabel}" />
                <TextBlock x:Name="GatewayText" Style="{StaticResource DataValue}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="无线网卡" Style="{StaticResource DataLabel}" />
                <TextBlock x:Name="AdapterText" Style="{StaticResource DataValue}" />
                <TextBlock Text="BSSID / MAC" Style="{StaticResource DataLabel}" />
                <TextBlock x:Name="BssidText" Style="{StaticResource DataValue}" />
                <TextBlock Text="频段 / 信道" Style="{StaticResource DataLabel}" />
                <TextBlock x:Name="BandChannelText" Style="{StaticResource DataValue}" />
              </StackPanel>
            </Grid>
            <TextBlock x:Name="SecurityAdviceText" Style="{StaticResource DataLabel}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="链路速率" Style="{StaticResource SectionTitle}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="协商下行" Style="{StaticResource DataLabel}" />
                <TextBlock x:Name="LinkRxText" FontSize="25" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="协商上行" Style="{StaticResource DataLabel}" />
                <TextBlock x:Name="LinkTxText" FontSize="25" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
            <TextBlock Text="实时流量" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
            <TextBlock x:Name="TrafficText" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="TotalTrafficText" Style="{StaticResource DataLabel}" Margin="0,5,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,7,14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="实时下载速率" Style="{StaticResource SectionTitle}" />
            <controls:HistoryChart x:Name="DownloadChart" Grid.Row="1" MinHeight="125"
                                   Accent="{DynamicResource AccentBrush}" />
          </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="实时上传速率" Style="{StaticResource SectionTitle}" />
            <controls:HistoryChart x:Name="UploadChart" Grid.Row="1" MinHeight="125"
                                   Accent="{DynamicResource BlueAccentBrush}" />
          </Grid>
        </Border>
      </Grid>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel>
              <TextBlock Text="网络测速与工具" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="ToolStatusText" Style="{StaticResource DataLabel}"
                         Text="测速会消耗流量；局域网扫描只会在本地子网发送 Ping。" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="SpeedTestButton" Content="开始测速"
                      Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                      Click="SpeedTestButton_Click" />
              <Button x:Name="ScanButton" Content="扫描局域网设备"
                      Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                      Click="ScanButton_Click" />
              <Button x:Name="RouterButton" Content="打开路由器"
                      Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                      Click="RouterButton_Click" />
              <Button x:Name="OptimizeButton" Content="网络优化"
                      Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                      Click="OptimizeButton_Click" />
              <Button x:Name="ResetNetworkButton" Content="重置网络协议"
                      Style="{StaticResource DangerButton}"
                      Click="ResetNetworkButton_Click" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="测速延迟" Style="{StaticResource DataLabel}" />
              <TextBlock x:Name="LatencyText" Style="{StaticResource DataValue}" Text="--" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="测速下载" Style="{StaticResource DataLabel}" />
              <TextBlock x:Name="SpeedDownloadText" Style="{StaticResource DataValue}" Text="--" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="测速上传" Style="{StaticResource DataLabel}" />
              <TextBlock x:Name="SpeedUploadText" Style="{StaticResource DataValue}" Text="--" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Grid>
              <TextBlock x:Name="SpeedPhaseText" Style="{StaticResource DataLabel}"
                         Text="准备测速" />
              <TextBlock x:Name="SpeedProgressText" Style="{StaticResource DataLabel}"
                         HorizontalAlignment="Right" Text="0%" />
            </Grid>
            <ProgressBar x:Name="SpeedProgress" Height="6" Margin="0,6,0,8"
                         Maximum="100" Value="0" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LatencyProgressText" Style="{StaticResource DataLabel}"
                         Text="延迟 0%" />
              <TextBlock x:Name="DownloadProgressText" Grid.Column="1"
                         Style="{StaticResource DataLabel}" Text="下载 0%" />
              <TextBlock x:Name="UploadProgressText" Grid.Column="2"
                         Style="{StaticResource DataLabel}" Text="上传 0%" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel>
              <TextBlock Text="同一局域网设备" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="LanStatusText" Style="{StaticResource DataLabel}"
                         Text="还没有扫描，点击上方按钮读取 ARP 和在线设备。" />
            </StackPanel>
          </Grid>
          <DataGrid x:Name="LanGrid" Grid.Row="1" Margin="0,8,0,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="IP 地址" Binding="{Binding IpAddress}" Width="1.1*" />
              <DataGridTextColumn Header="设备名称" Binding="{Binding HostName}" Width="1.7*"
                                  ElementStyle="{StaticResource GridTextCell}" />
              <DataGridTextColumn Header="MAC 地址" Binding="{Binding MacAddress}" Width="1.2*" />
              <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="1*" />
              <DataGridTextColumn Header="厂商推测" Binding="{Binding Vendor}" Width="1.2*" />
              <DataGridCheckBoxColumn Header="在线" Binding="{Binding Responsive}" Width="64" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
